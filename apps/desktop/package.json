{
  "name": "@joinery/desktop",
  "productName": "Joinery",
  "version": "0.1.0",
  "private": true,
  "description": "Joinery desktop app: Electron main, sandboxed preload, React renderer and connection hosts.",
  "author": "Joinery",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration --testTimeout=120000 --hookTimeout=120000",
    "test:e2e": "install-electron && electron-vite build && playwright test -c e2e/playwright.config.ts",
    "package": "electron-vite build && electron-builder --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "@glideapps/glide-data-grid": "^6.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@joinery/backup": "workspace:*",
    "@joinery/core": "workspace:*",
    "@joinery/driver-mongodb": "workspace:*",
    "@joinery/driver-elasticsearch": "workspace:*",
    "@joinery/driver-mysql": "workspace:*",
    "@joinery/driver-postgres": "workspace:*",
    "@joinery/driver-redis": "workspace:*",
    "@joinery/driver-sql-base": "workspace:*",
    "@joinery/ipc": "workspace:*",
    "@joinery/mongo-tools": "workspace:*",
    "@joinery/redis-tools": "workspace:*",
    "@joinery/search-tools": "workspace:*",
    "@joinery/sql-tools": "workspace:*",
    "@joinery/storage": "workspace:*",
    "@joinery/sync": "workspace:*",
    "@joinery/table-data": "workspace:*",
    "@joinery/transfer": "workspace:*",
    "@joinery/tunnel": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "dockview-react": "^8.3.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "monaco-editor": "^0.57.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-responsive-carousel": "^3.2.23",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^7.3.6",
    "vitest": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  }
}
