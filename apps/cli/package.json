{
  "name": "@querybara/cli",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "querybara-cli: headless connection tests, queries, structure compare and data compare.",
  "type": "module",
  "bin": {
    "querybara": "./dist/querybara.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "tsup && vitest run test/integration --testTimeout=120000 --hookTimeout=120000"
  },
  "dependencies": {
    "bson": "^7.3.3",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "socks": "^2.8.10",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@querybara/backup": "workspace:*",
    "@querybara/core": "workspace:*",
    "@querybara/driver-elasticsearch": "workspace:*",
    "@querybara/driver-mongodb": "workspace:*",
    "@querybara/driver-mysql": "workspace:*",
    "@querybara/driver-postgres": "workspace:*",
    "@querybara/driver-redis": "workspace:*",
    "@querybara/mongo-tools": "workspace:*",
    "@querybara/redis-tools": "workspace:*",
    "@querybara/search-tools": "workspace:*",
    "@querybara/sql-tools": "workspace:*",
    "@querybara/storage": "workspace:*",
    "@querybara/sync": "workspace:*",
    "@querybara/transfer": "workspace:*",
    "@querybara/tunnel": "workspace:*",
    "@types/node": "catalog:",
    "@types/ssh2": "^1.15.6",
    "commander": "^15.0.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
