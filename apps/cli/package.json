{
  "name": "@joinery/cli",
  "version": "0.1.0",
  "private": true,
  "description": "joinery-cli: headless connection tests, queries, structure compare and data compare.",
  "type": "module",
  "bin": {
    "joinery": "./dist/joinery.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "tsup && vitest run test/integration --testTimeout=120000 --hookTimeout=120000"
  },
  "dependencies": {
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0"
  },
  "devDependencies": {
    "@joinery/core": "workspace:*",
    "@joinery/driver-mysql": "workspace:*",
    "@joinery/driver-postgres": "workspace:*",
    "@joinery/sql-tools": "workspace:*",
    "@joinery/storage": "workspace:*",
    "@joinery/sync": "workspace:*",
    "@types/node": "catalog:",
    "commander": "^15.0.0",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
