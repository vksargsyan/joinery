{
  "name": "@querybara/transfer",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Streaming import and export (CSV, TSV, JSON, JSON Lines, Excel, XML, Parquet, HTML, Markdown, SQL, ZIP), column mapping and batched loads, and data transfer between databases.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration --passWithNoTests --testTimeout=120000 --hookTimeout=120000"
  },
  "dependencies": {
    "@querybara/core": "workspace:*",
    "@querybara/mongo-tools": "workspace:*",
    "@querybara/sql-tools": "workspace:*",
    "@querybara/sync": "workspace:*",
    "hyparquet": "1.31.1",
    "hyparquet-writer": "0.16.10"
  },
  "devDependencies": {
    "@querybara/driver-mongodb": "workspace:*",
    "@querybara/driver-mysql": "workspace:*",
    "@querybara/driver-postgres": "workspace:*",
    "@querybara/driver-redis": "workspace:*",
    "@querybara/driver-sql-base": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
