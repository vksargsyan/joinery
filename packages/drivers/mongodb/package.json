{
  "name": "@querybara/driver-mongodb",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "MongoDB driver adapter (the official mongodb package) with document, index, collection, GridFS, change stream and user services.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration --testTimeout=60000 --hookTimeout=60000"
  },
  "dependencies": {
    "@querybara/core": "workspace:*",
    "@querybara/driver-sql-base": "workspace:*",
    "@querybara/mongo-tools": "workspace:*",
    "@querybara/tunnel": "workspace:*",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
