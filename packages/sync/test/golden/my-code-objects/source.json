          "kind": "procedure",
          "language": "SQL",
          "definer": "app@%",
          "definition": "CREATE PROCEDURE `archive_orders`(IN days INT)\nBEGIN\n  -- keep a week at least\n  DELETE FROM orders WHERE created_at < NOW() - INTERVAL GREATEST(days, 7) DAY;\nEND"
