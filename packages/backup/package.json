{
  "name": "@querybara/backup",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Logical backup and restore: streaming SQL dumps, the Querybara archive (.qbak) with encryption and selective restore, MongoDB and Redis archives, and the native dump tools.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration --passWithNoTests --testTimeout=180000 --hookTimeout=180000"
  },
  "dependencies": {
    "@querybara/core": "workspace:*",
    "@querybara/mongo-tools": "workspace:*",
    "@querybara/sql-tools": "workspace:*",
    "@querybara/sync": "workspace:*",
    "@querybara/transfer": "workspace:*",
    "bson": "^7.3.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@querybara/driver-mongodb": "workspace:*",
    "@querybara/driver-mysql": "workspace:*",
    "@querybara/driver-postgres": "workspace:*",
    "@querybara/driver-redis": "workspace:*",
    "@querybara/driver-sql-base": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
