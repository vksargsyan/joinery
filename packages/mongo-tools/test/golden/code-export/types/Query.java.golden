// Maven: org.mongodb:mongodb-driver-sync
// Set MONGODB_URI to your connection string, e.g. mongodb://localhost:27017
import com.mongodb.client.FindIterable;
import com.mongodb.client.MongoClient;
import com.mongodb.client.MongoClients;
import com.mongodb.client.MongoCollection;
import com.mongodb.DBRef;
import org.bson.BsonBinary;
import org.bson.BsonRegularExpression;
import org.bson.BsonTimestamp;
import org.bson.Document;
import org.bson.types.Binary;
import org.bson.types.Code;
import org.bson.types.Decimal128;
import org.bson.types.MaxKey;
import org.bson.types.MinKey;
import org.bson.types.ObjectId;

import java.time.Instant;
import java.util.Arrays;
import java.util.Base64;
import java.util.Date;
import java.util.UUID;

public class Query {
    public static void main(String[] args) {
        String uri = System.getenv("MONGODB_URI");
        if (uri == null) {
            throw new IllegalStateException("Set the MONGODB_URI environment variable");
        }
        try (MongoClient client = MongoClients.create(uri)) {
            MongoCollection<Document> collection = client.getDatabase("shop").getCollection("types");
            Document filter = new Document("oid", new ObjectId("65a1b2c3d4e5f60718293a4b"))
                .append("date", Date.from(Instant.parse("2024-01-02T03:04:05.678Z")))
                .append("far", new Date(253402300800000L))
                .append("dec", Decimal128.parse("1234.5600"))
                .append("long", 9007199254740993L)
                .append("smallLong", 5L)
                .append("int", 42)
                .append("double", 1.0)
                .append("frac", 2.5)
                .append("nan", Double.NaN)
                .append("inf", Double.POSITIVE_INFINITY)
                .append("nzero", -0.0)
                .append("bin", new Binary((byte) 0x00, Base64.getDecoder().decode("AQIDBA==")))
                .append("userBin", new Binary((byte) 0x80, Base64.getDecoder().decode("AA==")))
                .append("uuid", new BsonBinary(UUID.fromString("a8098c1a-f86e-11da-bd1a-00112444be1e")))
                .append("re", new BsonRegularExpression("^ab+c", "i"))
                .append("reX", new BsonRegularExpression("a b # comment", "sx"))
                .append("ts", new BsonTimestamp(1700000000, 7))
                .append("tsBig", new BsonTimestamp(-1L))
                .append("min", new MinKey())
                .append("max", new MaxKey())
                .append("nul", null)
                .append("t", true)
                .append("s", "it's \"quoted\" \\ $var\n\ttab \u0001 é 😀")
                .append("nested", new Document("a", Arrays.asList(1, "x", new Document("b", null)))
                    .append("a.b", 1))
                .append("list", new Document("0", "a").append("1", "b"))
                .append("emptyDoc", new Document())
                .append("emptyArr", Arrays.asList())
                .append("single", Arrays.asList((Object) null))
                .append("code", new Code("function() { return 1; }"))
                .append("ref", new DBRef("things", new ObjectId("65a1b2c3d4e5f60718293a4c")));
            FindIterable<Document> results = collection.find(filter);
            for (Document document : results) {
                // The collection's codecs also cover DBRef, which Document.toJson() alone lacks.
                System.out.println(document.toJson(collection.getCodecRegistry().get(Document.class)));
            }
        }
    }
}
