# pip install pymongo
# Set MONGODB_URI to your connection string, e.g. mongodb://localhost:27017
import os
from datetime import datetime, timezone
from uuid import UUID

from bson import (
    Binary,
    Code,
    DBRef,
    DatetimeMS,
    Decimal128,
    Int64,
    MaxKey,
    MinKey,
    ObjectId,
    Regex,
    Timestamp,
)
from pymongo import MongoClient

with MongoClient(os.environ["MONGODB_URI"], datetime_conversion="DATETIME_AUTO") as client:
    collection = client["shop"]["types"]
    query_filter = {
        "oid": ObjectId("65a1b2c3d4e5f60718293a4b"),
        "date": datetime(2024, 1, 2, 3, 4, 5, 678000, tzinfo=timezone.utc),
        "far": DatetimeMS(253402300800000),
        "dec": Decimal128("1234.5600"),
        "long": Int64(9007199254740993),
        "smallLong": Int64(5),
        "int": 42,
        "double": 1.0,
        "frac": 2.5,
        "nan": float("nan"),
        "inf": float("inf"),
        "nzero": -0.0,
        "bin": Binary(bytes.fromhex("01020304"), 0),
        "userBin": Binary(bytes.fromhex("00"), 128),
        "uuid": Binary.from_uuid(UUID("a8098c1a-f86e-11da-bd1a-00112444be1e")),
        "re": Regex("^ab+c", "i"),
        "reX": Regex("a b # comment", "sx"),
        "ts": Timestamp(1700000000, 7),
        "tsBig": Timestamp(4294967295, 4294967295),
        "min": MinKey(),
        "max": MaxKey(),
        "nul": None,
        "t": True,
        "s": "it's \"quoted\" \\ $var\n\ttab \x01 é 😀",
        "nested": {"a": [1, "x", {"b": None}], "a.b": 1},
        "list": {"0": "a", "1": "b"},
        "emptyDoc": {},
        "emptyArr": [],
        "single": [None],
        "code": Code("function() { return 1; }"),
        "ref": DBRef("things", ObjectId("65a1b2c3d4e5f60718293a4c")),
    }
    for document in collection.find(query_filter):
        print(document)
