// npm install mongodb
// Set MONGODB_URI to your connection string, e.g. mongodb://localhost:27017
const {
  MongoClient,
  BSONRegExp,
  Binary,
  Code,
  DBRef,
  Decimal128,
  Double,
  Long,
  MaxKey,
  MinKey,
  ObjectId,
  Timestamp,
  UUID,
} = require('mongodb');

async function main() {
  const uri = process.env.MONGODB_URI;
  if (!uri) throw new Error('Set the MONGODB_URI environment variable');
  const client = new MongoClient(uri);
  try {
    const collection = client.db('shop').collection('types');
    const filter = {
      oid: new ObjectId('65a1b2c3d4e5f60718293a4b'),
      date: new Date('2024-01-02T03:04:05.678Z'),
      far: new Date('+010000-01-01T00:00:00.000Z'),
      dec: Decimal128.fromString('1234.5600'),
      long: Long.fromString('9007199254740993'),
      smallLong: Long.fromString('5'),
      int: 42,
      double: new Double(1),
      frac: 2.5,
      nan: NaN,
      inf: Infinity,
      nzero: new Double(-0),
      bin: Binary.createFromBase64('AQIDBA==', 0),
      userBin: Binary.createFromBase64('AA==', 128),
      uuid: new UUID('a8098c1a-f86e-11da-bd1a-00112444be1e'),
      re: /^ab+c/i,
      reX: new BSONRegExp('a b # comment', 'sx'),
      ts: new Timestamp({ t: 1700000000, i: 7 }),
      tsBig: new Timestamp({ t: 4294967295, i: 4294967295 }),
      min: new MinKey(),
      max: new MaxKey(),
      nul: null,
      t: true,
      s: 'it\'s "quoted" \\ $var\n\ttab \u0001 é 😀',
      nested: { a: [1, 'x', { b: null }], 'a.b': 1 },
      list: { '0': 'a', '1': 'b' },
      emptyDoc: {},
      emptyArr: [],
      single: [null],
      code: new Code('function() { return 1; }'),
      ref: new DBRef('things', new ObjectId('65a1b2c3d4e5f60718293a4c')),
    };
    for await (const document of collection.find(filter)) {
      console.log(document);
    }
  } finally {
    await client.close();
  }
}

main().catch((error) => {
  console.error(error);
  process.exitCode = 1;
});
