{
  "name": "@joinery/mongo-tools",
  "version": "0.0.0",
  "private": true,
  "description": "MongoDB shell-literal parser and formatter, Extended JSON helpers, find() text, schema analysis and document table views; pure TypeScript for the renderer and the driver.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration --passWithNoTests"
  },
  "dependencies": {
    "@joinery/core": "workspace:*",
    "bson": "^7.3.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
